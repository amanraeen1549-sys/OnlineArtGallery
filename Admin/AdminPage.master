              <li><a href="Uploadbyartist.aspx">Upload By Artist</a></li> 
              <li><a href="Quarry.aspx">Query</a></li>
            </ul>
            <br style="clear: left" />
        </div> <!-- end of menu -->
    
    	</div>
    
    <div id="tooplate_main">
    	<div id="tooplate_sidebar">
        	<%--<div class="sb_box">
            	<h3>Categories</h3>
                <ul class="sb_menu">
                    <li><a href="#">Animals</a></li>
