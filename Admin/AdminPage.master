        </div> <!-- end of sidebar -->
        
        	<div id="slider" class="nivoSlider">
                <img src="images/slider/01.jpg" alt="" title="Every artist was first an amateur”" />
                <img src="images/slider/02.jpg" alt="" title="Creativity takes courage" />
                <img src="images/slider/03.jpg" alt="" title="We don't take a photograph, we make it"/>
                <img src="images/slider/04.jpg" alt="" title="Art enables us to find ourselves and lose ourselves at the same time." />
            </div>
         
            <script type="text/javascript" src="js/jquery-1.4.3.min.js"></script>
            <script type="text/javascript" src="js/jquery.nivo.slider.js"></script>
            <script type="text/javascript">
            $(window).load(function() {
                $('#slider').nivoSlider();
            });
            </script>
        
